    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@prettier/plugin-pug": "^3.0.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.4.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vue/language-plugin-pug": "^2.0.29",
    "@vue/tsconfig": "^0.5.1",
    "dexie": "^4.0.8",
    "eslint": "^9.9.0",
    "eslint-plugin-vue": "^9.27.0",
    "fomantic-ui-css": "^2.9.3",
    "globals": "^15.9.0",
    "npm-run-all2": "^6.2.2",
    "prettier": "^3.3.3",
    "pug": "^3.0.3",
    "stylus": "^0.63.0",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.1.0",
    "vite": "^5.4.1",
    "vue-fomantic-ui": "^0.27.0",
    "vue-pug-syntax": "^1.0.1",
    "vue-tsc": "^2.0.29"
